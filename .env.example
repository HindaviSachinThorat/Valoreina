# Example environment variables for notifications
# Email (SMTP) settings — optional. Use Mailtrap or your SMTP provider for testing.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=notifications@example.com
EMAIL_TO=info.valoreina@gmail.com

# WhatsApp Cloud API settings — optional. See Facebook/Meta WhatsApp Cloud API docs.
# WHATSAPP_PHONE_ID: your WhatsApp Business Account phone ID (numeric)
# WHATSAPP_TOKEN: Bearer token for the Graph API
# WHATSAPP_TO: recipient number in international format without + (e.g. 918830287379)
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TO=

# Server runtime: (optional) set NODE_ENV=development or production as needed
NODE_ENV=development
